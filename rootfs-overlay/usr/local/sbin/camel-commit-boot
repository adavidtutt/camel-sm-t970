#!/bin/sh
set -eu

cmdline_file=${CAMEL_CMDLINE_FILE:-/proc/cmdline}
slot_file=${CAMEL_SLOT_FILE:-/run/camel-slot}
sd=${CAMEL_SD_ROOT:-/mnt/sd/camel-linux}
state_dir=$sd/state
state=$state_dir/boot-state
health_check=${CAMEL_HEALTH_CHECK:-/usr/local/sbin/camel-health-check}

[ -f "$state" ] || exit 0

field() {
  key=$1
  sed -n "s/^${key}=//p" "$state"
}

if [ -f "$slot_file" ]; then
  slot=$(sed -n '1p' "$slot_file")
else
  slot=$(sed -n 's/.*camel\.slot=\([AB]\).*/\1/p' "$cmdline_file")
fi
pending=$(field pending_slot)

case "$slot" in A|B) ;; *) exit 10 ;; esac
[ -n "$pending" ] || exit 0
[ "$slot" = "$pending" ] || {
  echo "Refusing to commit slot $slot while pending slot is $pending" >&2
  exit 11
}

"$health_check" || {
  echo "Refusing to commit slot $slot: recovery health check failed" >&2
  exit 15
}

release=$(field pending_release)
case "$release" in *[!A-Za-z0-9._-]*|'') exit 12 ;; esac

mkdir -p "$state_dir"
new="$state_dir/boot-state.new"
{
  printf 'format=2\n'
  printf 'active_slot=%s\n' "$slot"
  printf 'active_release=%s\n' "$release"
  printf 'tries_remaining=0\n'
} >"$new"
sync "$new"
mv -f "$new" "$state"
sync

touch "$state_dir/slot-${slot}.success"
echo "COMMITTED: CAMEL $release slot $slot"
